# --- SEA-Net additions ---
# Datasets are provisioned locally, never committed. This covers the UCR 2018 archive
# (~300MB, has its own license) and the synthetic WebTraffic csvs (~19MB). Reviewers get
# them separately; this keeps the repo small and `millet/` diffable against upstream MILLET.
/data/

# Saved model weights (large, regenerated by training). Covers MILLET's ExampleNet.pth,
# SEA-Net scratch/checkpoints, and any .pth anywhere.
/model/
*.pth

# MLflow local tracking store + saved model weights. These are binary and can grow large, so they are
# NOT committed (a database file in git bloats history and causes merge conflicts). Copy mlflow.db
# (and mlartifacts/ if you want the weights) from Grid5000 to your laptop with scp/rsync instead - see
# MLFLOW_GUIDE.md - then browse with `mlflow ui --backend-store-uri sqlite:///mlflow.db`.
/mlflow.db
/mlruns/
/mlartifacts/

# SMOKE-TEST outputs only. Smoke runs (python main.py ... --smoke) are throwaway 3-epoch pipeline
# checks, usually run on your laptop, so their outputs are ignored. REAL training outputs ARE kept and
# committed - real interpretation figures and real run logs - so a Grid5000 training run's record
# travels with the repo. Each model has its own folder (results/SEA_NET/<encoder>_<pooling>/), hence
# the wildcard: it covers every model, including ones added later.
/results/SEA_NET/*/logs/smoke/
/results/SEA_NET/*/interpretation/*/smoke/
/results/SEA_NET/logs/smoke/

# Internal notes / leftovers not needed in the public repo.
workflow.md
README_OLD.md
MILLET_Overview.png
*.tex

CLUSTERS_CMD.md
text papers/
# ICLR_2025_Report/

# --- The report ------------------------------------------------------------
# The line "*.tex" above was there to keep stray LaTeX scratch files out of the
# code repo. But the report sources we DO want in git, so we switch the rule
# back off for those folders only. (Order matters in .gitignore: a later "!"
# rule cancels an earlier ignore rule.)
#
# ICLR_2025_Report/Seanet is the REAL report I am writing. Without the line
# below the blanket "*.tex" above was hiding all of it from git - the whole
# draft was untracked and would have been lost by a git clean.
!/ICLR_2025_Report/**/*.tex
!/report/**/*.tex
!/results/paper_figures/**/*.tex

# Everything latexmk generates. It is rebuilt from the .tex files in seconds,
# so committing it would only create noise and merge conflicts.
/report/build/
/report/