# --- SEA-Net additions ---
# Datasets are provisioned locally, never committed. This covers the UCR 2018 archive
# (~300MB, has its own license) and the synthetic WebTraffic csvs (~19MB). Reviewers get
# them separately; this keeps the repo small and `millet/` diffable against upstream MILLET.
/data/

# Saved model weights (large, regenerated by training). Covers MILLET's ExampleNet.pth,
# SEA-Net scratch/checkpoints, and any .pth anywhere.
/model/
*.pth

# MLflow local tracking store (Optuna trials). Regenerated by `python main.py optuna`; each machine
# keeps its own. Browse it with `mlflow ui --backend-store-uri sqlite:///mlflow.db`.
/mlflow.db
/mlruns/
/mlartifacts/

# Generated interpretation figures (regenerated by `python main.py interpret`).
/results/SEA_NET/interpretation/

# Per-command run logs (a dated copy of the terminal output). Regenerated on every command.
/results/SEA_NET/logs/

# Internal notes / leftovers not needed in the public repo.
workflow.md
README_OLD.md
MILLET_Overview.png
*.tex