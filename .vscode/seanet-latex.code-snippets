{
  // Shortcuts for writing the report. Type the prefix in any .tex file and
  // press Tab. Saves typing the long results/paper_figures/... paths by hand.

  "SEA-Net: insert a generated figure": {
    "prefix": "seafig",
    "scope": "latex",
    "body": [
      "\\begin{figure}[t]",
      "  \\centering",
      "  \\includegraphics[width=\\linewidth]{results/paper_figures/${1|01_main_figures,02_ablation,03_appendix,04_web,05_statistics|}/${2:figure_name}}",
      "  \\caption{${3:What the reader should see in this figure.}}",
      "  \\label{fig:${4:short_key}}",
      "\\end{figure}",
      "$0"
    ],
    "description": "Figure block pointing at results/paper_figures/ (auto-generated by `python main.py paper`)"
  },

  "SEA-Net: insert a wide (2-column) generated figure": {
    "prefix": "seafigwide",
    "scope": "latex",
    "body": [
      "\\begin{figure*}[t]",
      "  \\centering",
      "  \\includegraphics[width=\\linewidth]{results/paper_figures/${1:01_main_figures}/${2:figure_name}}",
      "  \\caption{${3:Caption.}}",
      "  \\label{fig:${4:short_key}}",
      "\\end{figure*}",
      "$0"
    ],
    "description": "Full-width figure block"
  },

  "SEA-Net: insert a generated table": {
    "prefix": "seatable",
    "scope": "latex",
    "body": [
      "\\input{results/paper_figures/tables/${1|table1_main_results,table_appendix_full_leaderboard,table_ranking_accuracy,table_efficiency,table_appendix_per_dataset|}}",
      "$0"
    ],
    "description": "Pull in one of the auto-generated result tables"
  },

  "SEA-Net: TODO note": {
    "prefix": "todo",
    "scope": "latex",
    "body": ["\\todo{${1:what still needs writing}}$0"],
    "description": "Red TODO marker that shows up in the PDF"
  },

  "SEA-Net: new section file skeleton": {
    "prefix": "seasection",
    "scope": "latex",
    "body": [
      "\\section{${1:Section title}}",
      "\\label{sec:${2:key}}",
      "",
      "$0"
    ],
    "description": "Section header with a label"
  }
}
