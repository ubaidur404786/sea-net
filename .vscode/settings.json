{
  // ---------------- Python (was already here) ----------------
  "python-envs.defaultEnvManager": "ms-python.python:conda",
  "python-envs.defaultPackageManager": "ms-python.python:conda",

  // =====================================================================
  // LaTeX Workshop - this is what gives us the "Overleaf feel":
  // save the file -> it builds -> the PDF preview next to it refreshes.
  // =====================================================================

  // main.tex is the only file that should ever be compiled. The section
  // files are pieces of it, so do not try to build them on their own.
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.latex.rootFile.useSubFile": false,

  // The PDF and the helper files (.aux .log .bbl ...) land next to main.tex,
  // so the PDF is simply report/main.pdf. The helper files are hidden from the
  // explorer by "files.exclude" below and ignored by report/.gitignore, so they
  // never get in the way. (We tried a separate build/ folder first, but bibtex
  // always writes its .bbl into the folder you run it from, not next to the
  // .aux file, which quietly breaks the bibliography. Simpler is safer.)

  // ---- The three programs a LaTeX build actually uses -------------------
  // TEXINPUTS / BIBINPUTS / BSTINPUTS are the folders LaTeX searches.
  //   ..     -> the project root, so the paths that `python main.py paper`
  //             writes (results/paper_figures/...) work word-for-word
  //   style  -> our copy of iclr2025_conference.sty / .bst
  // The trailing ';' means "and after that, the normal MiKTeX folders too".
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",              // Ctrl+click PDF <-> source
        "-interaction=nonstopmode", // never stop to ask a question on an error
        "-file-line-error",        // errors as file:line:message (clickable)
        "%DOC%"
      ],
      "env": {
        "TEXINPUTS": "..;style;",
        "BIBINPUTS": "..;style;",
        "BSTINPUTS": "..;style;"
      }
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": ["%DOCFILE%"],
      "env": {
        "BIBINPUTS": "..;style;",
        "BSTINPUTS": "..;style;"
      }
    },
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-pdf", "%DOC%"],
      "env": {}
    }
  ],

  // WHY FOUR STEPS. LaTeX only does one pass over the file, so on pass 1 it does
  // not yet know what page Figure 3 is on or what number a citation gets. It
  // writes what it learned into main.aux and you run it again. bibtex reads that
  // .aux, looks the keys up in refs.bib and writes main.bbl; then two more
  // pdflatex passes pull the bibliography in and settle every \ref and \cite.
  // This is exactly what Overleaf does for you behind its green button.
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex x2 + bibtex (default, no Perl needed)",
      "tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"]
    },
    {
      "name": "pdflatex only (fast, skips the bibliography)",
      "tools": ["pdflatex"]
    },
    {
      "name": "latexmk (needs Perl installed)",
      "tools": ["latexmk"]
    }
  ],

  // Rebuild every time you hit Ctrl+S. Set this to "never" if your laptop
  // gets slow once the report is long.
  "latex-workshop.latex.autoBuild.run": "onSave",

  // ALWAYS use the first recipe above (pdflatex x2 + bibtex). Do not switch this to
  // "lastUsed": if you ever try the latexmk recipe, "lastUsed" would keep picking it
  // and every build would hang waiting for Perl.
  "latex-workshop.latex.recipe.default": "first",

  // Do NOT auto-delete the helper files: latexmk reuses them to build faster,
  // and it needs the .bbl to keep the bibliography around.
  "latex-workshop.latex.autoClean.run": "never",

  // Open the PDF in a VS Code tab (side by side with the source).
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,

  // The build log is noisy. Hide the warnings that are almost always harmless
  // (over/underfull boxes are just line-spacing complaints).
  "latex-workshop.message.badbox.show": false,

  // Autocomplete for \cite{...} shows the title, not just the key.
  "latex-workshop.intellisense.citation.label": "title",

  // ---------------- Grammar / spell check (LTeX) ----------------
  // We write British English ("normalise", "colour"). Change to en-US if needed.
  "ltex.language": "en-GB",
  "ltex.dictionary": {
    "en-GB": [
      "SEA-Net",
      "MILLET",
      "WebTraffic",
      "UCR",
      "AOPCR",
      "NDCG",
      "InceptionTime",
      "MSTCN",
      "conjunctive",
      "Pareto",
      "backbones",
      "hyperparameter",
      "hyperparameters"
    ]
  },

  // ---------------- Code Spell Checker ----------------
  // Project words it does not know yet, so the squiggles stay meaningful.
  "cSpell.words": [
    "aopcr",
    "bibtex",
    "booktabs",
    "cleveref",
    "conjunctive",
    "graphicspath",
    "graphicx",
    "iclr",
    "includegraphics",
    "inceptiontime",
    "kpsewhich",
    "latexmk",
    "latexmkrc",
    "millet",
    "miktex",
    "mstcn",
    "multirow",
    "natbib",
    "ndcg",
    "pdflatex",
    "seanet",
    "subcaption",
    "texinputs",
    "toprule",
    "midrule",
    "bottomrule",
    "webtraffic"
  ],

  // ---------------- Editor behaviour inside .tex / .bib ----------------
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false,
    "editor.rulers": [90]
  },
  "[bibtex]": {
    "editor.formatOnSave": false
  },

  // Do not clutter the file explorer with the helper files LaTeX drops next to
  // main.tex. They still exist on disk - LaTeX needs them - we just hide them.
  "files.exclude": {
    "**/*.aux": true,
    "**/*.bbl": true,
    "**/*.blg": true,
    "**/*.fdb_latexmk": true,
    "**/*.fls": true,
    "**/*.out": true,
    "**/*.synctex.gz": true,
    "**/*.toc": true
  }
}
